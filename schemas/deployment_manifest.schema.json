{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BitcoinChiangMai/bitcoin_endowment_standard/schemas/deployment_manifest.schema.json",
  "title": "BES 0001 deployment manifest",
  "description": "Structural summary of one deployment's published claims. Validation checks assertions, never conformance. See BES 0001 section 11.6.",
  "type": "object",
  "required": [
    "standard",
    "release",
    "organization",
    "spending_policy",
    "guardians",
    "risk_statement",
    "roles",
    "spending",
    "payment_authorization",
    "continuity",
    "evidence",
    "custody_operations",
    "legal",
    "conformance"
  ],
  "additionalProperties": false,
  "properties": {
    "standard": {
      "const": "BES 0001"
    },
    "release": {
      "type": "string",
      "oneOf": [
        {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        {
          "const": "editor_draft"
        }
      ],
      "description": "Exact release named by the deployment. Never a range and never 'latest'. editor_draft means no release is tagged, in which case no deployment should be relying on this."
    },
    "organization": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "jurisdiction": {
          "type": "string"
        }
      }
    },
    "spending_policy": {
      "type": "object",
      "description": "BES 0001 section 2. The most important object here. Everything else is decoration if an undisclosed path spends below the stated condition.",
      "required": [
        "network",
        "policy_published",
        "output_reconstructible",
        "key_origins_published",
        "paths",
        "weakest_authorization",
        "address_derivation_published",
        "key_path"
      ],
      "additionalProperties": false,
      "properties": {
        "network": {
          "enum": [
            "mainnet",
            "signet",
            "testnet",
            "regtest"
          ]
        },
        "policy_published": {
          "const": true,
          "description": "Section 2.1. Complete descriptor or equivalent policy expression published"
        },
        "descriptor_location": {
          "type": "string"
        },
        "key_origins_published": {
          "const": true,
          "description": "Section 2.1. Sufficient for watch only verification"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "description": "Section 2.1. Every key path, script path, and recovery branch. A policy listing one path is asserting there is exactly one.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "threshold",
              "participants",
              "roster",
              "enforcement"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "threshold": {
                "type": "integer",
                "minimum": 3,
                "description": "Section 2.5 floor for a script path, section 2.8 floor for an aggregate signing path. Both are three of five."
              },
              "participants": {
                "type": "integer",
                "minimum": 5
              },
              "timelock": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "roster": {
                "type": "array",
                "minItems": 5,
                "uniqueItems": true,
                "description": "Section 2.9. The parties that can participate in this path. Domain membership is intersected with this roster, per path.",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "enforcement": {
                "enum": [
                  "consensus_script",
                  "aggregate_signing"
                ],
                "description": "Section 2.6. Whether the threshold is committed in script or produced off chain by an aggregate signing protocol. Section 2.9 forbids presenting the second as consensus enforced."
              },
              "aggregate_protocol": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Section 2.8. Named when enforcement is aggregate_signing"
              }
            }
          }
        },
        "weakest_authorization": {
          "type": "object",
          "description": "Section 2.2. The smallest set of parties that can authorize a spend by any route.",
          "required": [
            "path",
            "m",
            "n"
          ],
          "additionalProperties": false,
          "properties": {
            "m": {
              "type": "integer",
              "minimum": 3
            },
            "n": {
              "type": "integer",
              "minimum": 5
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "description": "Section 2.3. The path these figures belong to. m and n are that path's own values, never a synthesis across paths."
            }
          }
        },
        "no_undisclosed_weaker_path": {
          "const": true,
          "description": "Section 2.3. An assertion, checkable only by deriving the policy"
        },
        "address_derivation_published": {
          "const": true,
          "description": "Section 2.7"
        },
        "third_party_influence": {
          "type": "array",
          "description": "Section 2.9. Coordinators or services able to influence, delay, or block a spend",
          "items": {
            "type": "string"
          }
        },
        "output_reconstructible": {
          "const": true,
          "description": "Section 2.2. Policy sufficient to reconstruct the exact on chain output, including a Taproot output key and script tree commitment"
        },
        "key_path": {
          "type": "object",
          "description": "Sections 2.7 and 2.8. State only whether the key path is enabled and, when it is not, the derivation proving the internal key has no known discrete logarithm. An enabled key path is published as an ordinary entry in paths, with enforcement aggregate_signing, so every weakest path, risk, and domain rule applies to it uniformly.",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "unspendable_internal_key_proof": {
              "type": [
                "string",
                "null"
              ],
              "description": "Section 2.7. Required when enabled is false"
            },
            "path": {
              "type": [
                "string",
                "null"
              ],
              "description": "Section 2.8. When enabled, the name of the entry in paths that describes it"
            }
          }
        }
      }
    },
    "guardians": {
      "type": "object",
      "description": "BES 0001 section 3",
      "required": [
        "count",
        "factors_disclosed",
        "domains",
        "analysis_date",
        "coercion_analysis_published",
        "residual_uncertainty_stated"
      ],
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 5
        },
        "one_share_each": {
          "const": true,
          "description": "Section 3.1"
        },
        "factors_disclosed": {
          "type": "array",
          "minItems": 9,
          "uniqueItems": true,
          "description": "Section 3.2. All nine factors, per guardian, or the analysis underneath is incomplete.",
          "items": {
            "enum": [
              "beneficial_owner",
              "employer_or_funding",
              "jurisdiction",
              "physical_location",
              "signing_stack",
              "backup_facility",
              "coordinator_dependency",
              "communication_dependency",
              "recovery_dependency"
            ]
          }
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "One input to section 3.5, never a substitute for it"
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "description": "Section 3.3 and 3.4. Every correlated failure domain, aggregated through common parent dependencies. Sizes are checked against m and n by tests/check_invariants.py, not by this schema.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "dependency",
              "kind",
              "guardians",
              "paths"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "dependency": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "control",
                  "compromise",
                  "coercion",
                  "unavailability"
                ]
              },
              "guardians": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "paths": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "coercion_analysis_published": {
          "const": true,
          "description": "Section 3.7"
        },
        "residual_uncertainty_stated": {
          "const": true,
          "description": "Section 3.7. A deployment may not claim to have proved no jurisdiction can reach m"
        },
        "analysis_date": {
          "type": "string",
          "format": "date",
          "description": "Section 3.9, at least annual"
        }
      }
    },
    "risk_statement": {
      "type": "object",
      "description": "BES 0001 section 3.7. Parameterized to this deployment, per path.",
      "required": [
        "published",
        "per_path"
      ],
      "additionalProperties": false,
      "properties": {
        "published": {
          "const": true
        },
        "per_path": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "unavailable_tolerated",
              "collusion_set"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "unavailable_tolerated": {
                "type": "integer",
                "minimum": 0,
                "description": "n minus m for this path"
              },
              "collusion_set": {
                "type": "integer",
                "minimum": 1,
                "description": "m for this path"
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "required": [
        "administrator_holds_share",
        "guardian_is_administrator",
        "action_types_published"
      ],
      "additionalProperties": false,
      "properties": {
        "administrator_holds_share": {
          "const": false,
          "description": "Section 4.2"
        },
        "guardian_is_administrator": {
          "const": false,
          "description": "Section 4.1"
        },
        "action_types_published": {
          "const": true,
          "description": "Section 4.7"
        },
        "independent_reconciler": {
          "type": "boolean",
          "description": "Section 4.8, a SHOULD"
        }
      }
    },
    "spending": {
      "type": "object",
      "required": [
        "source",
        "formula",
        "unit_of_account",
        "encumbrance"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "principal",
            "new_donations",
            "disclosed_income"
          ],
          "description": "Section 5.1"
        },
        "formula": {
          "type": "string",
          "minLength": 1,
          "description": "Section 5.3, including measurement window"
        },
        "unit_of_account": {
          "type": "string"
        },
        "encumbrance": {
          "const": false,
          "description": "Section 5.4. Lending, collateral, rehypothecation, or synthetic representation makes a deployment nonconformant, disclosed or not"
        },
        "other_assets": {
          "type": "array",
          "description": "Section 5.5",
          "items": {
            "type": "object",
            "required": [
              "holding",
              "purpose",
              "size",
              "counterparty"
            ],
            "additionalProperties": false,
            "properties": {
              "holding": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "size": {
                "type": "string"
              },
              "counterparty": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "payment_authorization": {
      "type": "object",
      "description": "BES 0001 section 7. Who decides and what is published. How a guardian verifies a transaction is operational and out of scope.",
      "required": [
        "request_published_or_committed",
        "independent_decision",
        "verification_procedure_published"
      ],
      "additionalProperties": false,
      "properties": {
        "request_published_or_committed": {
          "const": true,
          "description": "Section 7.1"
        },
        "independent_decision": {
          "const": true,
          "description": "Section 7.4"
        },
        "verification_procedure_published": {
          "const": true,
          "description": "Section 7.5"
        },
        "verification_procedure_standard": {
          "type": [
            "string",
            "null"
          ],
          "description": "Section 7.5. Null means no operational standard is claimed"
        }
      }
    },
    "continuity": {
      "type": "object",
      "description": "BES 0001 section 9. That recovery capability exists, is exercised, and is reported. The contents of a recovery plan are operational and belong to the standard named under section 12.2.",
      "required": [
        "plan_documented",
        "executed_end_to_end",
        "operational_standard",
        "last_rehearsal",
        "results_published",
        "scenarios"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_documented": {
          "const": true,
          "description": "Section 9.1"
        },
        "executed_end_to_end": {
          "const": true,
          "description": "Section 9.1"
        },
        "operational_standard": {
          "type": [
            "string",
            "null"
          ],
          "description": "Section 9.2. Null means none is followed"
        },
        "last_rehearsal": {
          "type": "string",
          "format": "date",
          "description": "Section 9.3"
        },
        "results_published": {
          "const": true,
          "description": "Section 9.4, including failures"
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "description": "Section 9.5. Each marked observed or simulated. A fee market spike is always simulated.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "observed",
                  "simulated"
                ]
              }
            }
          }
        },
        "replacement_days_observed": {
          "type": "integer",
          "minimum": 0,
          "description": "Section 9.6"
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "BES 0001 section 8",
      "required": [
        "location",
        "labels_applied",
        "publication_classes",
        "unverifiable_statement_published",
        "retention_policy_published"
      ],
      "additionalProperties": false,
      "properties": {
        "location": {
          "type": "string",
          "minLength": 1
        },
        "labels_applied": {
          "const": true,
          "description": "Section 8.3, a CONTROL and an EVIDENCE value on every claim"
        },
        "publication_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "description": "Section 8.4",
          "items": {
            "enum": [
              "public",
              "redacted",
              "committed",
              "delayed",
              "restricted"
            ]
          }
        },
        "unverifiable_statement_published": {
          "const": true,
          "description": "Section 8.6. What outsiders consequently cannot check"
        },
        "retention_policy_published": {
          "const": true,
          "description": "Section 8.7"
        }
      }
    },
    "custody_operations": {
      "type": "object",
      "description": "BES 0001 section 12. Either name a standard or say plainly that custody is unassessed.",
      "required": [
        "assessed"
      ],
      "additionalProperties": false,
      "properties": {
        "assessed": {
          "type": "boolean"
        },
        "standard": {
          "type": [
            "string",
            "null"
          ]
        },
        "release": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "legal": {
      "type": "object",
      "required": [
        "wrapper",
        "dissolution_legal_outcome",
        "dissolution_policy_reality"
      ],
      "additionalProperties": false,
      "properties": {
        "wrapper": {
          "type": [
            "string",
            "null"
          ],
          "description": "Null means none, a declined SHOULD under section 10.2"
        },
        "jurisdiction": {
          "type": [
            "string",
            "null"
          ]
        },
        "dissolution_legal_outcome": {
          "type": "string",
          "minLength": 1,
          "description": "Section 10.4"
        },
        "dissolution_policy_reality": {
          "type": "string",
          "minLength": 1,
          "description": "Section 10.5. Whether the guardians can technically disregard the legal outcome"
        },
        "controlling_document": {
          "type": "string"
        }
      }
    },
    "conformance": {
      "type": "object",
      "required": [
        "claim",
        "unmet_musts",
        "declined_shoulds"
      ],
      "additionalProperties": false,
      "properties": {
        "claim": {
          "enum": [
            "conformant",
            "based_on_with_declared_deviations"
          ],
          "description": "Section 11.1 and 11.2. These are the only two claims. A conformant claim with a non empty unmet_musts array is false."
        },
        "unmet_musts": {
          "type": "array",
          "description": "Section 11.4. Any entry here means the claim must be based_on_with_declared_deviations.",
          "items": {
            "type": "object",
            "required": [
              "clause",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "clause": {
                "type": "string",
                "pattern": "^\u00a7[0-9]+\\.[0-9]+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "declined_shoulds": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "clause",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "clause": {
                "type": "string",
                "pattern": "^\u00a7[0-9]+\\.[0-9]+$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim": {
                "const": "conformant"
              }
            },
            "required": [
              "claim"
            ]
          },
          "then": {
            "properties": {
              "unmet_musts": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}